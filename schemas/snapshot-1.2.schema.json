{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matthewpara567/pcpulse/blob/main/schemas/snapshot-1.2.schema.json",
  "title": "PCPulse Snapshot",
  "type": "object",
  "required": [
    "collected_at",
    "schema_version",
    "os",
    "kernel",
    "architecture",
    "cpu",
    "memory",
    "disks",
    "uptime_seconds"
  ],
  "properties": {
    "collected_at": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.2"
    },
    "os": {
      "type": "string"
    },
    "kernel": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "cpu": {
      "type": "object",
      "required": [
        "logical_cores",
        "physical_cores",
        "load_percent"
      ],
      "properties": {
        "logical_cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "physical_cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "load_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "total_bytes",
        "available_bytes",
        "used_bytes",
        "used_percent"
      ],
      "properties": {
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "available_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "total_bytes",
          "free_bytes",
          "used_percent"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "total_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "free_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "used_percent": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "uptime_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "hostname": {
      "type": [
        "string",
        "null"
      ]
    },
    "username": {
      "type": [
        "string",
        "null"
      ]
    },
    "extra": {
      "type": "object"
    },
    "swap": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "total_bytes",
        "used_bytes",
        "used_percent"
      ],
      "properties": {
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "battery": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "percent",
        "plugged_in"
      ],
      "properties": {
        "percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "plugged_in": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "design_capacity_mwh": {
          "type": [
            "integer",
            "null"
          ]
        },
        "full_charge_capacity_mwh": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cycle_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "health_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "is_up",
          "bytes_sent",
          "bytes_recv"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "is_up": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "bytes_sent": {
            "type": [
              "integer",
              "null"
            ]
          },
          "bytes_recv": {
            "type": [
              "integer",
              "null"
            ]
          },
          "send_rate_bytes_per_sec": {
            "type": [
              "number",
              "null"
            ]
          },
          "recv_rate_bytes_per_sec": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "temperatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "high_celsius": {
            "type": [
              "number",
              "null"
            ]
          },
          "critical_celsius": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "description": "Degrees Celsius. Empty when the platform exposes no sensors."
    },
    "fans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      },
      "description": "RPM. Empty when the platform exposes no sensors."
    },
    "processes": {
      "type": [
        "array",
        "null"
      ],
      "description": "Present only with --include-processes.",
      "items": {
        "type": "object",
        "required": [
          "pid",
          "name",
          "memory_percent",
          "rss_bytes"
        ],
        "properties": {
          "pid": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "memory_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rss_bytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "collection_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "error_type",
          "message"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "error_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": [
              "string",
              "null"
            ]
          },
          "utilization_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "memory_total_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "memory_used_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "temperature_celsius": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "hardware": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "cpu_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_frequency_mhz": {
          "type": [
            "number",
            "null"
          ]
        },
        "system_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "system_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "motherboard_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "motherboard_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "storage_health": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device",
          "health_status"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "health_status": {
            "type": "string"
          },
          "temperature_celsius": {
            "type": [
              "number",
              "null"
            ]
          },
          "percentage_used": {
            "type": [
              "number",
              "null"
            ]
          },
          "power_on_hours": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "disk_io": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "read_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "write_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "read_rate_bytes_per_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "write_rate_bytes_per_sec": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
