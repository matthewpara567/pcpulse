{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matthewpara567/pcpulse/blob/main/schemas/snapshot-1.0.schema.json",
  "title": "PCPulse Snapshot",
  "type": "object",
  "required": [
    "collected_at",
    "schema_version",
    "os",
    "kernel",
    "architecture",
    "cpu",
    "memory",
    "disks",
    "uptime_seconds"
  ],
  "properties": {
    "collected_at": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "os": {
      "type": "string"
    },
    "kernel": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "cpu": {
      "type": "object",
      "required": [
        "logical_cores",
        "physical_cores",
        "load_percent"
      ],
      "properties": {
        "logical_cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "physical_cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "load_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "total_bytes",
        "available_bytes",
        "used_bytes",
        "used_percent"
      ],
      "properties": {
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "available_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "total_bytes",
          "free_bytes",
          "used_percent"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "total_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "free_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "used_percent": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "uptime_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "hostname": {
      "type": [
        "string",
        "null"
      ]
    },
    "username": {
      "type": [
        "string",
        "null"
      ]
    },
    "extra": {
      "type": "object"
    }
  }
}
